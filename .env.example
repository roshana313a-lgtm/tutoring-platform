# SQLAlchemy database URL used for local development.
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Secret used to sign JWT access tokens; replace before production.
JWT_SECRET=change-me-in-production

# Algorithm used for JWT signing and verification.
JWT_ALGORITHM=HS256

# Lifetime of an issued JWT access token in minutes.
JWT_EXPIRE_MINUTES=60

# Frontend API base URL; leave empty to use the Vite /api proxy.
VITE_API_BASE_URL=
